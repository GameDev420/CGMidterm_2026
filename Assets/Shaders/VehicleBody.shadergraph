{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "19cc63eda95a4bb893035bf4c4765298",
    "m_Title": "Reflection",
    "m_Content": "This shader is fairly simple, as it essentially replaces its texture with the output of the nearest reflection probe in Unity (though you could also multiply the result by a texture if you had one).It takes the view direction and normal vector, both in object space, and passes it to a Reflection Probe node to sample its cubemap. Furthermore, it also had a reflection blurriness parameter specifically for the probe reflections, you would want it close to the material's smoothness for realistic results.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1197.174072265625,
        "y": 554.6541137695313,
        "width": 200.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

