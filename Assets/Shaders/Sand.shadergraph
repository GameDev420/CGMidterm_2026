{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f626deb7fdd64bba9521b5d85e5a14f5",
    "m_Title": "Process",
    "m_Content": "Basic Lit shader with standard properties (metallic, smoothness, base texture and color, etc.) with customizable, time-based texture offsets, which yields great results when paired with tileable textures. Simply multiplies the current game time by the offset speed, adds it with a base offset, and given along with the base UV (UV0) when sampling the texture. This shader also supports texture tiling, which pairs nicely with dynamic offsets. I believe using ShaderGraph here is effective due to the simplicity of the effect and using Unity's built-in lighting as it's not the focus of this shader.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1832.0,
        "y": 244.00001525878907,
        "width": 310.7257080078125,
        "height": 245.6920166015625
    },
    "m_Group": {
        "m_Id": ""
    }
}

